      <media:content url="https://mmbiz.qpic.cn/mmbiz_jpg/F7Eia5KuvzacjM8e3S6m36wVpK7viandHkMYBCR7tppZUsKHelgdeica32K293IWvGgvD0JVZZUDKNrhxqKKmJIWVzmsz7nQCqyL7V1evdfAO4/0?wx_fmt=jpeg" medium="image" />
